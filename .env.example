# Copy to .env.local and fill in. .env.local is gitignored.
# All values come from the Hyperswitch control center: https://app.hyperswitch.io

# Secret API key. Control center > Developers > API Keys > Create. Starts with snd_ in sandbox.
# Server only; never exposed to the browser.
HYPERSWITCH_API_KEY=

# Publishable key. Control center > Developers > API Keys (shown alongside the secret key). Starts with pk_snd_.
# Safe to expose; the checkout SDK uses it in the browser.
NEXT_PUBLIC_HYPERSWITCH_PUBLISHABLE_KEY=

# Business profile ID. Control center, the profile selector / Account settings.
# Optional: only needed when the merchant account has more than one profile.
HYPERSWITCH_PROFILE_ID=

# The profile's payment_response_hash_key, used to verify webhook signatures.
# Control center > Developers > Payment Settings > (your profile) > Webhook setup,
# or GET /account/{merchant_id}/business_profile/{profile_id}. Optional until you test webhooks.
HYPERSWITCH_WEBHOOK_SECRET=

# Hyperswitch API base. Defaults to the sandbox. Change only for production.
HYPERSWITCH_API_BASE_URL=https://sandbox.hyperswitch.io

# Public origin of this app, used to build the return_url Hyperswitch redirects to.
# Optional: when unset the app derives it from the request's host headers (works on Vercel and localhost).
NEXT_PUBLIC_APP_URL=
